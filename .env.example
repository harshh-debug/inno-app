NODE_ENV=development
PORT=3000
POSTGRES_USER=innogeeks
POSTGRES_PASSWORD=innogeeks_local
POSTGRES_DB=innogeeks
POSTGRES_PORT=5433
DATABASE_URL=postgresql://innogeeks:innogeeks_local@localhost:5433/innogeeks?schema=public
APP_URL=http://localhost:3000
# Optional email-worker tuning; defaults shown.
# EMAIL_POLL_INTERVAL_MS=1000
# EMAIL_BATCH_SIZE=5
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Innogeeks Recruitment <no-reply@innogeeks.local>
# SMTP_USER=
# SMTP_PASSWORD=
JWT_SECRET=replace-with-a-development-secret-of-at-least-32-characters
VERIFICATION_HASH_SECRET=replace-with-a-different-development-secret-of-at-least-32-characters
# Required only by `pnpm admin:seed`.
# ADMIN_SEED_EMAIL=
# ADMIN_SEED_PASSWORD=
