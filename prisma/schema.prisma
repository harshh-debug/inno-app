// Innogeeks — Prisma schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum PlatformRole {
  FIRST_YEAR_STUDENT
  COORDINATOR
  ADMIN
}

enum InputType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum RecruitmentDecision {
  PENDING
  SELECTED
  WAITLISTED
  REJECTED
}

enum VerificationCodePurpose {
  // Used only for the paid student's first-login email ownership check.
  // This is not an activation code.
  EMAIL_VERIFICATION
  PASSWORD_RESET  // future: forgot-password flow
}

enum TimelineEventType {
  TEST
  INTERVIEW
  CUSTOM
}

// ─────────────────────────────────────────────
// Core identity
// ─────────────────────────────────────────────

model User {
  id              String       @id @default(uuid()) @db.Uuid
  collegeEmail           String       @db.VarChar(320)
  personalEmail          String?      @map("personal_email") @db.VarChar(320)
  normalizedEmail String       @unique @map("normalized_email") @db.VarChar(320)
  passwordHash    String?      @map("password_hash")
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  role            PlatformRole @default(FIRST_YEAR_STUDENT)
  isSuspended     Boolean      @default(false) @map("is_suspended")

  // Student profile fields (only meaningful for FIRST_YEAR_STUDENT, kept on User
  // since one registration per cycle and no app-channel dedup complexity to justify
  // a separate profile table right now)
  fullName String? @map("full_name") @db.VarChar(200)
  phone    String? @db.VarChar(40)
  batch    String? @db.VarChar(100)
  year     Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  registrations     RegistrationSubmission[] @relation("Registrant")
  decisionsMade     RegistrationSubmission[] @relation("DecisionMadeBy")
  verificationCodes VerificationCode[]
  auditLogsAsActor  AuditLog[]

  @@index([role])
  @@index([fullName])
  @@map("users")
}

// ─────────────────────────────────────────────
// Recruitment cycle (academic session/year).
// Cycles are managed by admins and isolate historical recruitment data. Public
// and app clients do not select a cycle; backend services resolve the active one.
// ─────────────────────────────────────────────

model RecruitmentCycle {
  id           String  @id @default(uuid()) @db.Uuid
  name         String  @db.VarChar(200)
  academicYear String  @map("academic_year") @db.VarChar(30)
  isActive     Boolean @default(false) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  form           Form?
  registrations  RegistrationSubmission[]
  timelineEvents RecruitmentTimelineEvent[]
  // Retained future structure; interview booking is not a Phase 1 feature.
  interviewSlots InterviewSlot[]
  testSlots      TestSlot[]

  @@unique([academicYear])
  @@index([isActive])
  @@map("recruitment_cycles")
}

// ─────────────────────────────────────────────
// Dynamic registration form — one form per recruitment cycle.
//
// Admins may add, edit, reorder, activate, deactivate, and remove fields even
// after registration submissions exist. Phase 1 implements neither form locking
// nor form versioning.
//
// A field with no submitted answers may be permanently deleted. A field with
// submitted answers is removed by setting isActive = false, preserving its
// relation to historical answers. Newly added fields are never backfilled for
// existing submissions; missing answers are represented as null only in views.
// ─────────────────────────────────────────────

model Form {
  id                 String  @id @default(uuid()) @db.Uuid
  recruitmentCycleId String  @unique @map("recruitment_cycle_id") @db.Uuid
  title              String  @default("Registration Form") @db.VarChar(300)
  description        String? @db.Text
  submitButtonLabel  String  @default("Submit") @map("submit_button_label") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recruitmentCycle RecruitmentCycle         @relation(fields: [recruitmentCycleId], references: [id], onDelete: Restrict)
  fields           FormField[]
  submissions      RegistrationSubmission[]

  @@map("forms")
}

model FormField {
  id     String @id @default(uuid()) @db.Uuid
  formId String @map("form_id") @db.Uuid

  key         String    @db.VarChar(100) // stable machine key, e.g. "domain_interest"
  title       String    @db.VarChar(200)
  helpText    String?   @map("help_text") @db.Text
  type        InputType
  placeholder String?   @db.VarChar(300)

  // For SELECT / MULTI_SELECT / CHECKBOX: comma-separated options, e.g. "Web,ML,IoT,Android"
  // Split on "," when rendering or validating. If an option itself might contain a comma,
  // this will break — flag it if that's ever a real case and we'll switch delimiters.
  enum String? @db.Text

  required  Boolean @default(false)
  order     Int
  isActive  Boolean @default(true) @map("is_active")
  minLength Int?    @map("min_length")
  maxLength Int?    @map("max_length")
  minValue  Float?  @map("min_value")
  maxValue  Float?  @map("max_value")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  form            Form                  @relation(fields: [formId], references: [id], onDelete: Restrict)
  submittedInputs FormInputSubmission[]

  @@unique([formId, key])
  @@unique([formId, order])
  @@index([formId, isActive, order])
  @@map("form_fields")
}

// ─────────────────────────────────────────────
// Registration + payment + decision
// ─────────────────────────────────────────────

model RegistrationSubmission {
  id                String @id @default(uuid()) @db.Uuid
  applicationNumber Int    @unique @default(autoincrement()) @map("application_number")

  userId             String @map("user_id") @db.Uuid
  recruitmentCycleId String @map("recruitment_cycle_id") @db.Uuid
  formId             String @map("form_id") @db.Uuid

  // Phase 1 intentionally stores no fee amount, payment reference, note, or
  // verifier. The timestamp changes only when the admin changes payment state.
  paymentStatus          PaymentStatus @default(UNPAID) @map("payment_status")
  paymentStatusUpdatedAt DateTime      @default(now()) @map("payment_status_updated_at") @db.Timestamptz(3)

  decision     RecruitmentDecision @default(PENDING)
  decisionNote String?             @map("decision_note") @db.Text
  decidedAt    DateTime?           @map("decided_at") @db.Timestamptz(3)
  decidedById  String?             @map("decided_by_id") @db.Uuid

  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user              User             @relation("Registrant", fields: [userId], references: [id], onDelete: Restrict)
  recruitmentCycle  RecruitmentCycle @relation(fields: [recruitmentCycleId], references: [id], onDelete: Restrict)
  form              Form             @relation(fields: [formId], references: [id], onDelete: Restrict)
  decidedBy         User?            @relation("DecisionMadeBy", fields: [decidedById], references: [id], onDelete: SetNull)

  formInputs      FormInputSubmission[]
  // Future interview booking retained but unused by Phase 1.
  slotBooking     SlotBooking?
  testSlotBooking TestSlotBooking?

  @@unique([userId, recruitmentCycleId])
  @@index([recruitmentCycleId, paymentStatus])
  @@index([recruitmentCycleId, decision])
  @@map("registration_submissions")
}

model FormInputSubmission {
  id           String @id @default(uuid()) @db.Uuid
  submissionId String @map("submission_id") @db.Uuid
  fieldId      String @map("field_id") @db.Uuid

  fieldKey   String    @map("field_key") @db.VarChar(100) // snapshot, in case field key ever changes
  fieldTitle String    @map("field_title") @db.VarChar(200)
  fieldType  InputType @map("field_type")
  value      String    @db.Text // CHECKBOX/MULTI_SELECT multi-answers: comma-joined, same convention as FormField.enum

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submission RegistrationSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  field      FormField              @relation(fields: [fieldId], references: [id], onDelete: Restrict)

  @@unique([submissionId, fieldKey])
  @@index([submissionId])
  @@map("form_input_submissions")
}

// ─────────────────────────────────────────────
// Email verification codes
// ─────────────────────────────────────────────

model VerificationCode {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  normalizedEmail String                  @map("normalized_email") @db.VarChar(320)
  purpose         VerificationCodePurpose
  codeHash        String                  @map("code_hash")
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(3)

  failedAttempts    Int      @default(0) @map("failed_attempts")
  maxAttempts       Int      @default(5) @map("max_attempts")
  resendAvailableAt DateTime @map("resend_available_at") @db.Timestamptz(3)

  usedAt        DateTime? @map("used_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)

  // Issued after successful code verification; consumed by the password-creation step
  actionTokenHash      String?   @unique @map("action_token_hash")
  actionTokenExpiresAt DateTime? @map("action_token_expires_at") @db.Timestamptz(3)
  actionTokenUsedAt    DateTime? @map("action_token_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, expiresAt])
  @@index([normalizedEmail, purpose])
  @@map("verification_codes")
}

// ─────────────────────────────────────────────
// Recruitment timeline (student-facing)
// ─────────────────────────────────────────────

model RecruitmentTimelineEvent {
  id                 String            @id @default(uuid()) @db.Uuid
  recruitmentCycleId String            @map("recruitment_cycle_id") @db.Uuid
  type               TimelineEventType
  title              String            @db.VarChar(200)
  description        String?           @db.Text
  scheduledAt        DateTime?         @map("scheduled_at") @db.Timestamptz(3)
  location           String?           @db.Text
  meetingUrl         String?           @map("meeting_url") @db.Text
  instructions       String?           @db.Text
  order              Int
  isVisible          Boolean           @default(false) @map("is_visible")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recruitmentCycle RecruitmentCycle @relation(fields: [recruitmentCycleId], references: [id], onDelete: Restrict)

  @@unique([recruitmentCycleId, order])
  @@index([recruitmentCycleId, isVisible, order])
  @@map("recruitment_timeline_events")
}

// ─────────────────────────────────────────────
// Test-slot booking — Phase 1 model.
// Capacity is validated at the service layer by counting bookings. Each
// registration can select one test slot in its own recruitment cycle.
// ─────────────────────────────────────────────

model TestSlot {
  id                 String   @id @default(uuid()) @db.Uuid
  recruitmentCycleId String   @map("recruitment_cycle_id") @db.Uuid
  startTime          DateTime @map("start_time") @db.Timestamptz(3)
  endTime            DateTime @map("end_time") @db.Timestamptz(3)
  order              Int
  isVisible          Boolean  @default(false) @map("is_visible")
  capacity           Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recruitmentCycle RecruitmentCycle @relation(fields: [recruitmentCycleId], references: [id], onDelete: Restrict)
  bookings         TestSlotBooking[]

  @@unique([recruitmentCycleId, order])
  @@index([recruitmentCycleId, isVisible, order])
  @@map("test_slots")
}

model TestSlotBooking {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @unique @map("submission_id") @db.Uuid
  testSlotId   String   @map("test_slot_id") @db.Uuid
  bookedAt     DateTime @default(now()) @map("booked_at") @db.Timestamptz(3)

  submission RegistrationSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  testSlot   TestSlot               @relation(fields: [testSlotId], references: [id], onDelete: Restrict)

  @@index([testSlotId])
  @@map("test_slot_bookings")
}

// ─────────────────────────────────────────────
// Interview slot booking — future structure retained but unused in Phase 1.
// Admin pre-creates fixed slots (date/time/capacity/interviewer);
// student books one open slot. Capacity is enforced at the service layer
// by counting active (non-cancelled) SlotBooking rows against slot.capacity.
// ─────────────────────────────────────────────

model InterviewSlot {
  id                 String   @id @default(uuid()) @db.Uuid
  recruitmentCycleId String   @map("recruitment_cycle_id") @db.Uuid
  interviewerName    String   @map("interviewer_name") @db.VarChar(200)
  startTime          DateTime @map("start_time") @db.Timestamptz(3)
  endTime            DateTime @map("end_time") @db.Timestamptz(3)
  location           String?  @db.Text
  meetingUrl         String?  @map("meeting_url") @db.Text
  capacity           Int      @default(1)
  isCancelled        Boolean  @default(false) @map("is_cancelled")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recruitmentCycle RecruitmentCycle @relation(fields: [recruitmentCycleId], references: [id], onDelete: Restrict)
  bookings         SlotBooking[]

  @@index([recruitmentCycleId, startTime])
  @@map("interview_slots")
}

model SlotBooking {
  id           String    @id @default(uuid()) @db.Uuid
  submissionId String    @unique @map("submission_id") @db.Uuid // one interview booking per student per cycle
  slotId       String    @map("slot_id") @db.Uuid
  bookedAt     DateTime  @default(now()) @map("booked_at") @db.Timestamptz(3)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)

  submission RegistrationSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  slot       InterviewSlot          @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([slotId])
  @@map("slot_bookings")
}

// ─────────────────────────────────────────────
// Audit log — flagged addition, not explicitly requested.
// Remove if not wanted; nothing else in the schema depends on it.
// ─────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(100) // e.g. "REGISTRATION_MARKED_PAID", "DECISION_UPDATED"
  targetEntity  String   @map("target_entity") @db.VarChar(100)
  targetId      String   @map("target_id") @db.Uuid
  previousState Json?    @map("previous_state") @db.JsonB
  newState      Json?    @map("new_state") @db.JsonB
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetEntity, targetId])
  @@index([actorId])
  @@map("audit_logs")
}
